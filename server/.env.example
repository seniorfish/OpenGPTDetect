# Copy this file to .env and adjust the values. The server reads server/.env
# if present, otherwise plain environment variables.

# GGUF model file (required). Point this at your local GGUF model.
MODEL_PATH=./models/Qwen3.5-9B-Base.gguf

# Display name, only shown by /health.
MODEL_NAME=Qwen3.5-9B-Base

# Max context length (token hard cap).
N_CTX=2048

# Max characters accepted by the text endpoints.
MAX_CHAR_COUNT=4096

# llama.cpp logical / physical batch sizes.
N_BATCH=1024
N_UBATCH=512

# 1 = use PyTorch for NLL (auto-selects cuda/xpu/cpu), 0 = force numpy.
PPL_USE_TORCH=1

# uvicorn listen port.
PORT=8000

# Backend that serves requests: "llamacpp" (default, needs MODEL_PATH) or
# "mock" (deterministic, no model file, for frontend development / tests).
BACKEND=llamacpp

# Future API-layer sliding window switch: when enabled, the API chunks inputs
# beyond a backend's per-segment limit and resumes scoring with a recent-window
# prefix. Not implemented yet; currently controls nothing.
SLIDING_WINDOW=0